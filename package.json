{
  "name": "openbase-vscode",
  "displayName": "OpenBase CLI",
  "description": "Visual Studio Code extension for OpenBase CLI",
  "version": "10.3.3",
  "publisher": "openbase",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openbase",
          "title": "OpenBase",
          "icon": "icon-activitybar.svg"
        },
        {
          "id": "openbase-sqlrunner",
          "title": "OpenBase SQL Runner",
          "icon": "icon-sqlrunner.svg"
        },
        {
          "id": "openbase-httprunner",
          "title": "OpenBase HTTP Runner",
          "icon": "icon-httprunner.svg"
        }
      ]
    },
    "views": {
      "openbase": [
        {
          "type": "webview",
          "id": "openbase.panel",
          "name": "New Project"
        }
      ],
      "openbase-sqlrunner": [
        {
          "type": "webview",
          "id": "openbase.sqlrunner.sidebar",
          "name": "SQL Runner"
        },
        {
          "id": "openbase.sqlrunner.tables",
          "name": "Tables"
        },
        {
          "id": "openbase.sqlrunner.scripts",
          "name": "Scripts"
        }
      ],
      "openbase-httprunner": [
        {
          "type": "webview",
          "id": "openbase.httprunner.sidebar",
          "name": "HTTP Runner"
        },
        {
          "id": "openbase.httprunner.requests",
          "name": "Requests"
        }
      ]
    },
    "commands": [
      {
        "command": "openbase.newProject",
        "title": "OpenBase: New Project",
        "category": "OpenBase"
      },
      {
        "command": "openbase.scaffold",
        "title": "OpenBase: Scaffold",
        "category": "OpenBase"
      },
      {
        "command": "openbase.scaffoldUpdate",
        "title": "OpenBase: Scaffold Update",
        "category": "OpenBase"
      },
      {
        "command": "openbase.specialist",
        "title": "OpenBase: Specialist",
        "category": "OpenBase"
      },
      {
        "command": "openbase.procedure",
        "title": "OpenBase: Procedure",
        "category": "OpenBase"
      },
      {
        "command": "openbase.extensionAdd",
        "title": "OpenBase: Add Extension",
        "category": "OpenBase"
      },
      {
        "command": "openbase.extensionList",
        "title": "OpenBase: List Extensions",
        "category": "OpenBase"
      },
      {
        "command": "openbase.build",
        "title": "OpenBase: Build",
        "category": "OpenBase"
      },
      {
        "command": "openbase.run",
        "title": "OpenBase: Run",
        "category": "OpenBase"
      },
      {
        "command": "openbase.update",
        "title": "OpenBase: Update CLI",
        "category": "OpenBase"
      },
      {
        "command": "openbase.history",
        "title": "OpenBase: History",
        "category": "OpenBase"
      },
      {
        "command": "openbase.version",
        "title": "OpenBase: Version",
        "category": "OpenBase"
      },
      {
        "command": "openbase.sqlRunner",
        "title": "OpenBase: SQL Runner",
        "category": "OpenBase",
        "icon": "$(database)"
      },
      {
        "command": "openbase.httpRunner",
        "title": "OpenBase: HTTP Runner",
        "category": "OpenBase",
        "icon": "$(globe)"
      },
      {
        "command": "openbase.sqlRunner.run",
        "title": "OpenBase: Run SQL Query",
        "category": "OpenBase"
      },
      {
        "command": "openbase.httpRunner.send",
        "title": "OpenBase: Send HTTP Request",
        "category": "OpenBase"
      },
      {
        "command": "openbase.sqlRunner.tables.refresh",
        "title": "Refresh Tables",
        "category": "OpenBase",
        "icon": "$(refresh)"
      },
      {
        "command": "openbase.sqlRunner.tables.select",
        "title": "SELECT from Table",
        "category": "OpenBase",
        "icon": "$(play)"
      },
      {
        "command": "openbase.sqlRunner.tables.inspect",
        "title": "Inspect Table",
        "category": "OpenBase",
        "icon": "$(symbol-class)"
      },
      {
        "command": "openbase.sqlRunner.scripts.refresh",
        "title": "Refresh Scripts",
        "category": "OpenBase",
        "icon": "$(refresh)"
      },
      {
        "command": "openbase.sqlRunner.scripts.new",
        "title": "New SQL Script",
        "category": "OpenBase",
        "icon": "$(add)"
      },
      {
        "command": "openbase.sqlRunner.scripts.newFolder",
        "title": "New Folder",
        "category": "OpenBase",
        "icon": "$(new-folder)"
      },
      {
        "command": "openbase.sqlRunner.scripts.open",
        "title": "Open in SQL Runner",
        "category": "OpenBase",
        "icon": "$(play)"
      },
      {
        "command": "openbase.sqlRunner.scripts.rename",
        "title": "Rename",
        "category": "OpenBase"
      },
      {
        "command": "openbase.sqlRunner.scripts.delete",
        "title": "Delete",
        "category": "OpenBase",
        "icon": "$(trash)"
      },
      {
        "command": "openbase.httpRunner.requests.refresh",
        "title": "Refresh Requests",
        "category": "OpenBase",
        "icon": "$(refresh)"
      },
      {
        "command": "openbase.httpRunner.requests.new",
        "title": "New HTTP Request",
        "category": "OpenBase",
        "icon": "$(add)"
      },
      {
        "command": "openbase.httpRunner.requests.newFolder",
        "title": "New Folder",
        "category": "OpenBase",
        "icon": "$(new-folder)"
      },
      {
        "command": "openbase.httpRunner.requests.open",
        "title": "Open in HTTP Runner",
        "category": "OpenBase",
        "icon": "$(play)"
      },
      {
        "command": "openbase.httpRunner.requests.rename",
        "title": "Rename",
        "category": "OpenBase"
      },
      {
        "command": "openbase.httpRunner.requests.delete",
        "title": "Delete",
        "category": "OpenBase",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "openbase.sqlRunner.run",
        "key": "f8",
        "when": "activeWebviewPanelId == 'openbase.sqlRunner'"
      },
      {
        "command": "openbase.httpRunner.send",
        "key": "f8",
        "when": "activeWebviewPanelId == 'openbase.httpRunner'"
      }
    ],
    "viewsWelcome": [
      {
        "view": "workbench.explorer.emptyView",
        "contents": "[New OpenBase Project](command:openbase.newProject)"
      }
    ],
    "menus": {
      "commandPalette": [],
      "view/title": [
        {
          "command": "openbase.sqlRunner",
          "when": "view == openbase.panel",
          "group": "navigation"
        },
        {
          "command": "openbase.httpRunner",
          "when": "view == openbase.panel",
          "group": "navigation"
        },
        {
          "command": "openbase.specialist",
          "when": "view == openbase.panel",
          "group": "1_openbase"
        },
        {
          "command": "openbase.sqlRunner.tables.refresh",
          "when": "view == openbase.sqlrunner.tables",
          "group": "navigation"
        },
        {
          "command": "openbase.sqlRunner.scripts.new",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "navigation@1"
        },
        {
          "command": "openbase.sqlRunner.scripts.newFolder",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "navigation@2"
        },
        {
          "command": "openbase.sqlRunner.scripts.refresh",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "navigation@3"
        },
        {
          "command": "openbase.httpRunner.requests.new",
          "when": "view == openbase.httprunner.requests",
          "group": "navigation@1"
        },
        {
          "command": "openbase.httpRunner.requests.newFolder",
          "when": "view == openbase.httprunner.requests",
          "group": "navigation@2"
        },
        {
          "command": "openbase.httpRunner.requests.refresh",
          "when": "view == openbase.httprunner.requests",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "openbase.sqlRunner.tables.select",
          "when": "view == openbase.sqlrunner.tables && viewItem == table",
          "group": "inline"
        },
        {
          "command": "openbase.sqlRunner.scripts.open",
          "when": "view == openbase.sqlrunner.scripts && viewItem == script",
          "group": "inline@1"
        },
        {
          "command": "openbase.sqlRunner.scripts.delete",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "inline@2"
        },
        {
          "command": "openbase.sqlRunner.scripts.new",
          "when": "view == openbase.sqlrunner.scripts && viewItem == folder",
          "group": "1_edit@1"
        },
        {
          "command": "openbase.sqlRunner.scripts.newFolder",
          "when": "view == openbase.sqlrunner.scripts && viewItem == folder",
          "group": "1_edit@2"
        },
        {
          "command": "openbase.sqlRunner.scripts.rename",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "2_edit@1"
        },
        {
          "command": "openbase.sqlRunner.scripts.delete",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "2_edit@2"
        },
        {
          "command": "openbase.httpRunner.requests.open",
          "when": "view == openbase.httprunner.requests && viewItem == script",
          "group": "inline@1"
        },
        {
          "command": "openbase.httpRunner.requests.delete",
          "when": "view == openbase.httprunner.requests",
          "group": "inline@2"
        },
        {
          "command": "openbase.httpRunner.requests.new",
          "when": "view == openbase.httprunner.requests && viewItem == folder",
          "group": "1_edit@1"
        },
        {
          "command": "openbase.httpRunner.requests.newFolder",
          "when": "view == openbase.httprunner.requests && viewItem == folder",
          "group": "1_edit@2"
        },
        {
          "command": "openbase.httpRunner.requests.rename",
          "when": "view == openbase.httprunner.requests",
          "group": "2_edit@1"
        },
        {
          "command": "openbase.httpRunner.requests.delete",
          "when": "view == openbase.httprunner.requests",
          "group": "2_edit@2"
        }
      ],
      "explorer/context": [
        {
          "command": "openbase.newProject",
          "when": "explorerResourceIsFolder",
          "group": "openbase@1"
        },
        {
          "command": "openbase.scaffold",
          "when": "explorerResourceIsFolder",
          "group": "openbase@2"
        },
        {
          "command": "openbase.scaffoldUpdate",
          "when": "explorerResourceIsFolder",
          "group": "openbase@3"
        },
        {
          "command": "openbase.specialist",
          "when": "explorerResourceIsFolder",
          "group": "openbase@4"
        },
        {
          "command": "openbase.procedure",
          "when": "explorerResourceIsFolder",
          "group": "openbase@5"
        },
        {
          "command": "openbase.extensionAdd",
          "when": "explorerResourceIsFolder",
          "group": "openbase@6"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0"
  }
}
