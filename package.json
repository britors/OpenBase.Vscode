        "category": "OpenBase"
      },
      {
        "command": "openbase.newProject",
        "title": "New Project",
        "description": "Cria um novo projeto OpenBase .NET.",
        "category": "OpenBase"
      },
      {
        "command": "openbase.scaffold",
