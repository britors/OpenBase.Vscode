{
  "name": "openbase-vscode",
  "displayName": "OpenBase CLI",
  "description": "Visual Studio Code extension for OpenBase CLI",
  "version": "1.2.0",
  "publisher": "openbase",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openbase",
          "title": "OpenBase",
          "icon": "icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "openbase": [
        {
          "type": "webview",
          "id": "openbase.panel",
          "name": "New Project"
        }
      ]
    },
    "commands": [
      {
        "command": "openbase.newProject",
        "title": "OpenBase: New Project",
        "category": "OpenBase"
      },
      {
        "command": "openbase.scaffold",
        "title": "OpenBase: Scaffold",
        "category": "OpenBase"
      },
      {
        "command": "openbase.scaffoldUpdate",
        "title": "OpenBase: Scaffold Update",
        "category": "OpenBase"
      },
      {
        "command": "openbase.specialist",
        "title": "OpenBase: Specialist",
        "category": "OpenBase"
      },
      {
        "command": "openbase.procedure",
        "title": "OpenBase: Procedure",
        "category": "OpenBase"
      },
      {
        "command": "openbase.extensionAdd",
        "title": "OpenBase: Add Extension",
        "category": "OpenBase"
      },
      {
        "command": "openbase.extensionList",
        "title": "OpenBase: List Extensions",
        "category": "OpenBase"
      },
      {
        "command": "openbase.build",
        "title": "OpenBase: Build",
        "category": "OpenBase"
      },
      {
        "command": "openbase.run",
        "title": "OpenBase: Run",
        "category": "OpenBase"
      },
      {
        "command": "openbase.update",
        "title": "OpenBase: Update CLI",
        "category": "OpenBase"
      },
      {
        "command": "openbase.history",
        "title": "OpenBase: History",
        "category": "OpenBase"
      },
      {
        "command": "openbase.version",
        "title": "OpenBase: Version",
        "category": "OpenBase"
      }
    ],
    "viewsWelcome": [
      {
        "view": "workbench.explorer.emptyView",
        "contents": "[New OpenBase Project](command:openbase.newProject)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "openbase.newProject",
          "when": "explorerResourceIsFolder",
          "group": "openbase@1"
        },
        {
          "command": "openbase.scaffold",
          "when": "explorerResourceIsFolder",
          "group": "openbase@2"
        },
        {
          "command": "openbase.scaffoldUpdate",
          "when": "explorerResourceIsFolder",
          "group": "openbase@3"
        },
        {
          "command": "openbase.specialist",
          "when": "explorerResourceIsFolder",
          "group": "openbase@4"
        },
        {
          "command": "openbase.procedure",
          "when": "explorerResourceIsFolder",
          "group": "openbase@5"
        },
        {
          "command": "openbase.extensionAdd",
          "when": "explorerResourceIsFolder",
          "group": "openbase@6"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0"
  }
}
