    "keybindings": [
      {
        "command": "openbase.sqlRunner.run",
        "key": "f8",
        "when": "activeWebviewPanelId == 'openbase.sqlRunner'"
      },
      {
        "command": "openbase.httpRunner.send",
        "key": "f8",
        "when": "activeWebviewPanelId == 'openbase.httpRunner'"
      }
    ],
    "viewsWelcome": [
      {
        "view": "workbench.explorer.emptyView",
        "contents": "[New OpenBase Project](command:openbase.newProject)"
      }
    ],
    "menus": {
      "commandPalette": [],
      "view/title": [
        {
          "command": "openbase.taskRunner.refresh",
          "when": "view == openbase.taskrunner.tree",
          "group": "navigation"
        },
        {
          "command": "openbase.sqlRunner",
          "when": "view == openbase.panel",
          "group": "navigation"
        },
        {
          "command": "openbase.httpRunner",
          "when": "view == openbase.panel",
          "group": "navigation"
        },
        {
          "command": "openbase.specialist",
          "when": "view == openbase.panel",
          "group": "1_openbase"
        },
        {
          "command": "openbase.sqlRunner.erDiagram",
          "when": "view == openbase.sqlrunner.tables",
          "group": "navigation"
        },
        {
          "command": "openbase.sqlRunner.erDiagram",
          "when": "view == openbase.erdiagram.sidebar",
          "group": "navigation"
        },
        {
          "command": "openbase.sqlRunner.tables.changeSchema",
          "when": "view == openbase.sqlrunner.tables",
          "group": "navigation"
        },
        {
          "command": "openbase.sqlRunner.tables.filter",
          "when": "view == openbase.sqlrunner.tables",
          "group": "navigation"
        },
        {
          "command": "openbase.sqlRunner.tables.clearFilter",
          "when": "view == openbase.sqlrunner.tables",
          "group": "navigation"
        },
        {
          "command": "openbase.sqlRunner.tables.refresh",
          "when": "view == openbase.sqlrunner.tables",
          "group": "navigation"
        },
        {
          "command": "openbase.sqlRunner.scripts.new",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "navigation@1"
        },
        {
          "command": "openbase.sqlRunner.scripts.newFolder",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "navigation@2"
        },
        {
          "command": "openbase.sqlRunner.scripts.refresh",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "navigation@3"
        },
        {
          "command": "openbase.httpRunner.requests.new",
          "when": "view == openbase.httprunner.requests",
          "group": "navigation@1"
        },
        {
          "command": "openbase.httpRunner.requests.newFolder",
          "when": "view == openbase.httprunner.requests",
          "group": "navigation@2"
        },
        {
          "command": "openbase.httpRunner.requests.refresh",
          "when": "view == openbase.httprunner.requests",
          "group": "navigation@3"
        },
        {
          "command": "openbase.httpRunner.requests.importSwagger",
          "when": "view == openbase.httprunner.requests",
          "group": "navigation@4"
        },
        {
          "command": "openbase.endpointsMap.refresh",
          "when": "view == openbase.httprunner.endpoints",
          "group": "navigation"
        },
        {
          "command": "openbase.migrationRunner.migrateUp",
          "when": "view == openbase.migrationrunner.migrations",
          "group": "navigation@1"
        },
        {
          "command": "openbase.migrationRunner.dryRun",
          "when": "view == openbase.migrationrunner.migrations",
          "group": "navigation@2"
        },
        {
          "command": "openbase.migrationRunner.refresh",
          "when": "view == openbase.migrationrunner.migrations",
          "group": "navigation@3"
        },
        {
          "command": "openbase.dependencyInspector.updateAll",
          "when": "view == openbase.depinspector.packages",
          "group": "navigation@1"
        },
        {
          "command": "openbase.dependencyInspector.toggleFilter",
          "when": "view == openbase.depinspector.packages",
          "group": "navigation@2"
        },
        {
          "command": "openbase.dependencyInspector.refresh",
          "when": "view == openbase.depinspector.packages",
          "group": "navigation@3"
        },
        {
          "command": "openbase.solutionExplorer.buildAll",
          "when": "view == openbase.solutionexplorer.tree",
          "group": "navigation@1"
        },
        {
          "command": "openbase.solutionExplorer.debug",
          "when": "view == openbase.solutionexplorer.tree",
          "group": "navigation@2"
        },
        {
          "command": "openbase.solutionExplorer.test",
          "when": "view == openbase.solutionexplorer.tree",
          "group": "navigation@3"
        },
        {
          "command": "openbase.solutionExplorer.publish",
          "when": "view == openbase.solutionexplorer.tree",
          "group": "navigation@4"
        },
        {
          "command": "openbase.solutionExplorer.refresh",
          "when": "view == openbase.solutionexplorer.tree",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "openbase.taskRunner.openInBrowser",
          "when": "view == openbase.taskrunner.tree && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "openbase.taskRunner.develop",
          "when": "view == openbase.taskrunner.tree && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "openbase.taskRunner.toSpecialist",
          "when": "view == openbase.taskrunner.tree && viewItem == task",
          "group": "inline@3"
        },
        {
          "command": "openbase.sqlRunner.tables.select",
          "when": "view == openbase.sqlrunner.tables && viewItem == table",
          "group": "inline"
        },
        {
          "command": "openbase.sqlRunner.scripts.open",
          "when": "view == openbase.sqlrunner.scripts && viewItem == script",
          "group": "inline@1"
        },
        {
          "command": "openbase.sqlRunner.scripts.delete",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "inline@2"
        },
        {
          "command": "openbase.sqlRunner.scripts.new",
          "when": "view == openbase.sqlrunner.scripts && viewItem == folder",
          "group": "1_edit@1"
        },
        {
          "command": "openbase.sqlRunner.scripts.newFolder",
          "when": "view == openbase.sqlrunner.scripts && viewItem == folder",
          "group": "1_edit@2"
        },
        {
          "command": "openbase.sqlRunner.scripts.rename",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "2_edit@1"
        },
        {
          "command": "openbase.sqlRunner.scripts.delete",
          "when": "view == openbase.sqlrunner.scripts",
          "group": "2_edit@2"
        },
        {
          "command": "openbase.httpRunner.requests.open",
          "when": "view == openbase.httprunner.requests && viewItem == script",
          "group": "inline@1"
        },
        {
          "command": "openbase.httpRunner.requests.delete",
          "when": "view == openbase.httprunner.requests",
          "group": "inline@2"
        },
        {
          "command": "openbase.httpRunner.requests.new",
          "when": "view == openbase.httprunner.requests && viewItem == folder",
          "group": "1_edit@1"
        },
        {
          "command": "openbase.httpRunner.requests.newFolder",
          "when": "view == openbase.httprunner.requests && viewItem == folder",
          "group": "1_edit@2"
        },
        {
          "command": "openbase.httpRunner.requests.rename",
          "when": "view == openbase.httprunner.requests",
          "group": "2_edit@1"
        },
        {
          "command": "openbase.httpRunner.requests.delete",
          "when": "view == openbase.httprunner.requests",
          "group": "2_edit@2"
        },
        {
          "command": "openbase.endpointsMap.open",
          "when": "view == openbase.httprunner.endpoints && viewItem == endpoint",
          "group": "inline"
        },
        {
          "command": "openbase.migrationRunner.dryRunTo",
          "when": "view == openbase.migrationrunner.migrations && (viewItem == migration-applied || viewItem == migration-pending)",
          "group": "inline@1"
        },
        {
          "command": "openbase.migrationRunner.migrateTo",
          "when": "view == openbase.migrationrunner.migrations && (viewItem == migration-applied || viewItem == migration-pending)",
          "group": "inline@2"
        },
        {
          "command": "openbase.dependencyInspector.update",
          "when": "view == openbase.depinspector.packages && viewItem == dep-outdated",
          "group": "inline"
        },
        {
          "command": "openbase.solutionExplorer.build",
          "when": "view == openbase.solutionexplorer.tree && viewItem == project",
          "group": "openbase@1"
        },
        {
          "command": "openbase.solutionExplorer.run",
          "when": "view == openbase.solutionexplorer.tree && viewItem == project",
          "group": "openbase@2"
        },
        {
          "command": "openbase.solutionExplorer.openTerminal",
          "when": "view == openbase.solutionexplorer.tree && viewItem == project",
          "group": "openbase@3"
        }
      ],
      "explorer/context": [
        {
