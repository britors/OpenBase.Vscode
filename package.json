{
  "name": "openbase",
  "displayName": "OpenBase CLI Tool",
  "description": "Visual Studio Code extension for OpenBase CLI",
  "version": "10.13.6-dev",
  "publisher": "RodrigoSoaresdeBrito",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "walkthroughs": [
      {
        "id": "openbase-welcome",
        "title": "Começando com OpenBase",
        "description": "Aprenda a usar as funcionalidades principais do OpenBase.",
        "steps": [
          {
            "id": "new-project",
            "title": "Criar Projeto",
            "description": "Aprenda a usar o comando 'OpenBase: New Project'.",
            "media": {
              "markdown": "walkthroughs/welcome.md"
            }
          }
        ]
      }
    ],
    "chatParticipants": [
      {
        "id": "openbase.participant",
        "name": "openbase",
        "description": "Interact with OpenBase tools and CLI",
        "isSticky": false
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openbase",
          "title": "OpenBase",
          "icon": "icon-activitybar.svg"
        },
        {
          "id": "openbase-sqlrunner",
          "title": "OpenBase SQL Runner",
          "icon": "icon-sqlrunner.svg"
        },
        {
          "id": "openbase-httprunner",
          "title": "OpenBase HTTP Runner",
          "icon": "icon-httprunner.svg"
        },
        {
          "id": "openbase-erdiagram",
          "title": "OpenBase ER Diagram",
          "icon": "icon-erdiagram.svg"
        },
        {
          "id": "openbase-migrationrunner",
          "title": "OpenBase Migration Runner",
          "icon": "icon-migrationrunner.svg"
        },
        {
          "id": "openbase-tools",
          "title": "OpenBase Tools",
          "icon": "icon-tools.svg"
        },
        {
          "id": "openbase-solutionexplorer",
          "title": "OpenBase Solution Explorer",
          "icon": "icon-solutionexplorer.svg"
        },
        {
          "id": "openbase-taskrunner",
          "title": "OpenBase Task Runner",
          "icon": "$(issues)"
        }
      ]
    },
    "configuration": {
      "title": "OpenBase",
      "properties": {
        "openbase.editor.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save SQL scripts and HTTP requests while editing."
        }
      }
    },
    "views": {
      "openbase-taskrunner": [
        {
          "id": "openbase.taskrunner.tree",
          "name": "GitHub Issues"
        }
      ],
      "openbase": [
        {
          "type": "webview",
          "id": "openbase.panel",
          "name": "New Project"
        }
      ],
      "openbase-sqlrunner": [
        {
          "type": "webview",
          "id": "openbase.sqlrunner.sidebar",
          "name": "SQL Runner"
        },
        {
          "id": "openbase.sqlrunner.tables",
          "name": "Tables"
        },
        {
          "id": "openbase.sqlrunner.scripts",
          "name": "Scripts"
        }
      ],
      "openbase-httprunner": [
        {
          "type": "webview",
          "id": "openbase.httprunner.sidebar",
          "name": "HTTP Runner"
        },
        {
          "id": "openbase.httprunner.requests",
          "name": "Requests"
        },
        {
          "id": "openbase.httprunner.endpoints",
          "name": "Endpoints Map"
        }
      ],
      "openbase-erdiagram": [
        {
          "type": "webview",
          "id": "openbase.erdiagram.sidebar",
          "name": "ER Diagram"
        }
      ],
      "openbase-migrationrunner": [
        {
          "type": "webview",
          "id": "openbase.migrationrunner.sidebar",
          "name": "Migration Runner"
        },
        {
          "id": "openbase.migrationrunner.migrations",
          "name": "Migrations"
        }
      ],
      "openbase-solutionexplorer": [
        {
          "id": "openbase.solutionexplorer.tree",
          "name": "Solution Explorer"
        }
      ],
      "openbase-tools": [
        {
          "type": "webview",
          "id": "openbase.logviewer.sidebar",
          "name": "Log Viewer"
        },
        {
          "type": "webview",
          "id": "openbase.monitor.sidebar",
          "name": "Monitor"
        },
        {
          "type": "webview",
          "id": "openbase.depinspector.sidebar",
          "name": "Dependency Inspector"
        },
        {
          "id": "openbase.depinspector.packages",
          "name": "Packages"
        }
      ]
    },
